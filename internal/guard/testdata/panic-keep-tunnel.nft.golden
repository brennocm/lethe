table inet lethe_panic {
	set tunnel_ifaces {
		type ifname;
		elements = { "tun0", "wg0" };
	}
	set endpoints4 {
		type ipv4_addr . inet_proto . inet_service;
		elements = { 198.51.100.7 . udp . 51820, 203.0.113.9 . tcp . 443 };
	}
	set endpoints6 {
		type ipv6_addr . inet_proto . inet_service;
		elements = { 2001:db8::7 . udp . 51820 };
	}
	chain output {
		type filter hook output priority -20; policy drop;
		oifname "lo" accept
		oifname @tunnel_ifaces accept
		meta mark 0x0000ca6c accept
		socket cgroupv2 level 2 "system.slice/openvpn-client@work.service" accept # id 4242
		meta skuid 108 ip daddr . meta l4proto . th dport @endpoints4 accept
		meta skuid 108 ip6 daddr . meta l4proto . th dport @endpoints6 accept
		ip daddr . meta l4proto . th dport @endpoints4 accept
		ip6 daddr . meta l4proto . th dport @endpoints6 accept
		udp sport 68 udp dport 67 accept
		udp sport 546 udp dport 547 accept
		icmpv6 type nd-router-solicit accept
		icmpv6 type nd-neighbor-solicit accept
		icmpv6 type nd-neighbor-advert accept
		icmpv6 type mld2-listener-report accept
	}
	chain forward {
		type filter hook forward priority -20; policy drop;
	}
	chain input {
		type filter hook input priority -20; policy drop;
		iifname "lo" accept
		iifname @tunnel_ifaces accept
		ip saddr . meta l4proto . th sport @endpoints4 accept
		ip6 saddr . meta l4proto . th sport @endpoints6 accept
	}
}

table netdev lethe_l2 {
	set endpoints4 {
		type ipv4_addr . inet_proto . inet_service;
		elements = { 198.51.100.7 . udp . 51820, 203.0.113.9 . tcp . 443 };
	}
	set endpoints6 {
		type ipv6_addr . inet_proto . inet_service;
		elements = { 2001:db8::7 . udp . 51820 };
	}
	chain egress_enp0s31f6 {
		type filter hook egress device "enp0s31f6" priority -500; policy accept;
		meta protocol arp accept
		meta mark 0x0000ca6c accept
		meta skuid 108 ip daddr . meta l4proto . th dport @endpoints4 accept
		meta skuid 108 ip6 daddr . meta l4proto . th dport @endpoints6 accept
		ip daddr . meta l4proto . th dport @endpoints4 accept
		ip6 daddr . meta l4proto . th dport @endpoints6 accept
		meta protocol ip udp sport 68 udp dport 67 accept
		meta protocol ip6 udp sport 546 udp dport 547 accept
		icmpv6 type nd-router-solicit accept
		icmpv6 type nd-neighbor-solicit accept
		icmpv6 type nd-neighbor-advert accept
		icmpv6 type mld2-listener-report accept
		limit rate 100/second burst 200 packets log group 4242 prefix "LETHE-L2 "
		drop
	}
	chain egress_wlp2s0 {
		type filter hook egress device "wlp2s0" priority -500; policy accept;
		meta protocol arp accept
		meta mark 0x0000ca6c accept
		meta skuid 108 ip daddr . meta l4proto . th dport @endpoints4 accept
		meta skuid 108 ip6 daddr . meta l4proto . th dport @endpoints6 accept
		ip daddr . meta l4proto . th dport @endpoints4 accept
		ip6 daddr . meta l4proto . th dport @endpoints6 accept
		meta protocol ip udp sport 68 udp dport 67 accept
		meta protocol ip6 udp sport 546 udp dport 547 accept
		icmpv6 type nd-router-solicit accept
		icmpv6 type nd-neighbor-solicit accept
		icmpv6 type nd-neighbor-advert accept
		icmpv6 type mld2-listener-report accept
		limit rate 100/second burst 200 packets log group 4242 prefix "LETHE-L2 "
		drop
	}
}
